{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd admin && npm install --no-audit --no-fund && npm run build"
  },
  "deploy": {
    "startCommand": "cd admin && npm start -- -p $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
